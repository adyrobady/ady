# Copy this file to `.env` and fill in your Alpaca PAPER trading keys.
# Get them from: https://app.alpaca.markets/paper/dashboard/overview  (Generate / View API keys)
#
# The `.env` file is gitignored and will never be committed.

APCA_API_KEY_ID=your_paper_key_id_here
APCA_API_SECRET_KEY=your_paper_secret_key_here

# Paper trading endpoint (leave as-is for paper; change only for live trading).
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# --- Home Assistant MCP (used by Claude Code via .mcp.json) ---
# Base URL of your Home Assistant instance (no trailing slash).
HASS_URL=http://homeassistant.local:8123
# Long-lived access token: HA profile -> Security -> Long-lived access tokens -> Create token
HASS_TOKEN=your_long_lived_access_token_here
